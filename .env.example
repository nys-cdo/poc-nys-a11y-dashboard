# NYS Accessibility Dashboard — data-generation secrets.
# Copy to `.env` and fill in. These are read ONLY by scripts/generate.mjs at
# build time. They are NEVER imported by client code and NEVER shipped in the
# published bundle. `.env` is gitignored.

# --- axe Monitor (Deque) — axe Monitor Public API v1 ---
# Authoritative source for agency grouping (Scan Groups) + composite score.
# Base = your per-tenant Monitor host + /monitor-public-api/v1
#   e.g. https://acme.dequecloud.com/monitor-public-api/v1
# Auth = header  X-API-Key: <key>   (create the key in axe Account → API Keys,
#        product "axe Monitor").
AXE_MONITOR_API_BASE=https://YOURCOMPANY.dequecloud.com/monitor-public-api/v1
AXE_MONITOR_API_KEY=

# --- SiteImprove — Siteimprove API v2 ---
# Second source of coverage. Auth = HTTP Basic (account email : API key).
# Base = https://api.eu.siteimprove.com/v2 for EU tenants.
#        (US/global tenants use a different host — confirm for your account.)
SITEIMPROVE_API_BASE=https://api.eu.siteimprove.com/v2
SITEIMPROVE_API_USER=
SITEIMPROVE_API_KEY=
